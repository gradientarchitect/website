---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
const flow = [
  { step: 'Quote', system: 'CPQ' },
  { step: 'Approval agent', system: 'LLM · Cloud Run', focus: true },
  { step: 'Order', system: 'Order Mgmt' },
  { step: 'Invoice', system: 'Billing' },
  { step: 'Cash', system: 'ERP' },
];
const now = [
  { label: 'Studying', text: 'Google Cloud Associate Cloud Engineer, ACE15 cohort' },
  { label: 'Building', text: 'A quote-approval agent on Cloud Run, due January 2027' },
  { label: 'Designing', text: 'B2B Revenue Cloud Advanced solution areas' },
];
const certs = [
  'Agentforce Specialist',
  'Google Cloud Generative AI Leader',
  'Industries CPQ Developer',
  'OmniStudio Developer',
  'OmniStudio Consultant',
  'Platform Developer I',
  'Administrator',
];
---
<Base grid>
  <div class="hero" slot="hero">
    <div class="hero-copy">
      <span class="eyebrow">Sadhiq · Solution architect</span>
      <h1>I design how revenue flows from quote to cash, with AI agents on top.</h1>
      <p>15+ years on Salesforce. Industries CPQ, Revenue Cloud, billing and ERP integrations. Now adding Google Cloud and agentic AI, and writing down every step.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/blog">Read the blog</a>
        <a class="btn btn-ghost" href="/lab">See the lab</a>
      </div>
    </div>
    <figure class="flow" aria-labelledby="flow-cap">
      {flow.map((f, i) => (
        <>
          {i > 0 && <div class="flow-line" aria-hidden="true" />}
          <div class:list={['flow-box', { focus: f.focus }]}><span>{f.step}</span><span class="sys">{f.system}</span></div>
        </>
      ))}
      <figcaption id="flow-cap">fig. 1 · where the agent sits in the flow</figcaption>
    </figure>
  </div>

  <section class="wrap" aria-label="Now">
    <div class="now">
      <span class="eyebrow">Now</span>
      {now.map((n) => <div><strong>{n.label}</strong><span>{n.text}</span></div>)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="latest">
    <div class="section-head">
      <h2 id="latest">Latest writing</h2>
      <a href="/blog">All posts</a>
    </div>
    <div class="cards">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>

  <section class="wrap" aria-labelledby="lab-title">
    <div class="lab navy grid">
      <div class="lab-copy">
        <span class="eyebrow">Lab · In progress</span>
        <h2 id="lab-title">Quote approval agent</h2>
        <p>An LLM agent that reads a quote, checks it against discount thresholds and margin rules, and recommends approve, reject or escalate, with its reasons. Built on Cloud Run with an LLM API.</p>
      </div>
      <dl class="specs">
        <div><dt>Stack</dt><dd>Cloud Run · LLM API</dd></div>
        <div><dt>Domain</dt><dd>Quote-to-Cash</dd></div>
        <div><dt>Demo</dt><dd class="amber">January 2027</dd></div>
      </dl>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="certs">
    <h2 id="certs" class="h-sm">Certifications</h2>
    <ul class="tags">
      {certs.map((c) => <li class="tag">{c}</li>)}
      <li class="tag pending">In progress: Associate Cloud Engineer</li>
    </ul>
  </section>
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding: 72px 0 96px; }
  .hero-copy { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-weight: 800; font-size: clamp(38px, 5.6vw, 68px); line-height: 1.02; letter-spacing: -0.025em; }
  .hero p { margin: 0; max-width: 560px; font-size: 19px; line-height: 30px; color: var(--on-navy-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }

  .flow { flex: 1 1 300px; min-width: 0; margin: 0; display: flex; flex-direction: column; font-family: var(--font-mono); font-size: 14px; line-height: 20px; }
  .flow-box { border: 1.5px solid rgb(255 255 255 / 0.7); border-radius: var(--radius-md); padding: 14px 18px; display: flex; justify-content: space-between; gap: 12px; }
  .flow-box .sys { color: var(--on-navy-muted); }
  .flow-box.focus { border: 2px solid var(--amber); background: rgb(232 163 61 / 0.12); color: var(--amber); }
  .flow-box.focus .sys { color: var(--amber); }
  .flow-line { width: 1.5px; height: 28px; background: rgb(255 255 255 / 0.7); align-self: center; }
  .flow figcaption { padding-top: 16px; font-size: 12px; color: var(--on-navy-muted); }

  .now { display: flex; flex-wrap: wrap; gap: 16px 48px; margin-top: 72px; padding-block: 28px; border-block: 1px solid var(--hairline); }
  .now > div { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; }
  .now strong { font-weight: 600; }
  .now > div span { color: var(--slate); font-size: 15px; line-height: 22px; }
  .now .eyebrow { flex: 0 0 auto; }
  @media (max-width: 720px) { .now .eyebrow { flex-basis: 100%; } }

  .section { padding-block: 72px; }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 32px; }
  .section-head h2 { font-size: 34px; line-height: 40px; letter-spacing: -0.015em; }
  .section-head a { font-weight: 600; font-size: 15px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 24px; }

  .lab { display: flex; flex-wrap: wrap; gap: 40px; align-items: center; padding: clamp(24px, 4vw, 48px); border-radius: var(--radius-md); background-size: 24px 24px; }
  .lab-copy { flex: 999 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .lab h2 { font-size: 32px; line-height: 1.15; letter-spacing: -0.015em; }
  .lab p { margin: 0; color: var(--on-navy-muted); max-width: 560px; }
  .specs { flex: 1 1 240px; min-width: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-family: var(--font-mono); font-size: 14px; line-height: 20px; }
  .specs div { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid rgb(255 255 255 / 0.15); }
  .specs div:last-child { border-bottom: 0; padding-bottom: 0; }
  .specs dt { color: var(--on-navy-muted); }
  .specs dd { margin: 0; text-align: right; }
  .amber { color: var(--amber); }

  .h-sm { font-size: 26px; line-height: 32px; letter-spacing: -0.01em; margin-bottom: 24px; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
</style>
